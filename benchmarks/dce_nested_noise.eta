// Inner-loop work computes only dead locals.
use io

main(args:int[][]) {
  i:int = 0
  live:int = 0
  dead:int = 13
  while i < 16000 {
    j:int = 0
    while j < 16000 {
      dead = i * j + live
      dead = dead * 7 - j
      j = j + 1
    }
    live = live + i
    i = i + 1
  }
  printi(live)
  println("")
}
