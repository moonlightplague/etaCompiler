// Values live across calls should prefer callee-save registers over spills.
use io

mix(a:int,b:int,c:int,d:int,e:int,f:int):int {
  return a * 3 + b * 5 - c * 7 + d * 11 - e * 13 + f * 17
}

main(args:int[][]) {
  i:int,a:int,b:int,c:int,d:int = 0,1,2,3,4
  e:int,f:int,g:int,h:int,s:int = 5,6,7,8,0
  while i < 35000000 {
    t:int = mix(a,b,c,d,e,f)
    s = s + t + g - h
    a = b + t; b = c + s; c = d + i
    d = e + g; e = f + h; f = a + c
    g = g + 1; h = h + 2; i = i + 1
  }
  printi(s + a + b + c + d + e + f + g + h)
  println("")
}
