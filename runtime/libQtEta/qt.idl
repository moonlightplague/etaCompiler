pointer QWheelEvent: QInputEvent {
    bindH [[
        QWheelEvent* getImpl() {
            return static_cast<QWheelEvent*>(e);
        }
    ]]

    // angleDelta() returns a QPoint. The Y coordinate represents vertical 
    // scroll, which is what the old delta() returned.
    int delta() [[
        return __this->impl()->angleDelta().y();
    ]]

    // position() returns a QPointF (floating point) in modern Qt, 
    // so we cast it back to a standard QPoint to keep Eta happy.
    QPoint pos() [[
        return toEta(__this->impl()->position().toPoint());
    ]]

    QPoint globalPos() [[
        return toEta(__this->impl()->globalPosition().toPoint());
    ]]

    // angleDelta().x() is non-zero if the user is scrolling horizontally.
    Orientation orientation() [[
        // 1. Allocate the Eta object
        EtaOrientation* out = gcNew<EtaOrientation>();
        
        // 2. Evaluate the modern Qt5 delta and assign the raw Qt enum to the wrapper's value
        out->value = __this->impl()->angleDelta().x() != 0 ? Qt::Horizontal : Qt::Vertical;
        
        // 3. Return the wrapped object
        return out;
    ]]
}

