                return static_cast<EtaQPixmap*>(this)->getImpl();
            if (vtable()->toWidget(this))
                return static_cast<EtaQWidget*>(this)->getImpl();
            return 0;
        }
    ]]

    QPixmap toPixmap() [[
        return 0;
    ]]

    QWidget toWidget() [[
