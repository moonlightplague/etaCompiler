use io

swap(a:int[], i:int, j:int) {
  tmp:int = a[i]
  a[i] = a[j]
  a[j] = tmp
}

partition(a:int[], lo:int, hi:int):int {
  pivotIndex:int = lo + (hi - lo + 1) / 2
  swap(a, pivotIndex, hi)

  pivot:int = a[hi]
  store:int = lo
  i:int = lo

  while i < hi {
    if a[i] <= pivot {
      swap(a, i, store)
      store = store + 1
    }
    i = i + 1
  }

  swap(a, store, hi)
  return store
}

quicksort(a:int[], lo:int, hi:int) {
  if lo < hi {
    p:int = partition(a, lo, hi)
    quicksort(a, lo, p - 1)
    quicksort(a, p + 1, hi)
  }
}

printAll(a:int[]) {
  i:int = 0
  while i < length(a) {
    if i > 0 {
      print(" ")
    }
    printi(a[i])
    i = i + 1
  }
  println("")
}

printEnds(a:int[]) {
  i:int = 0
  while i < 5 {
    if i > 0 {
      print(" ")
    }
    printi(a[i])
    i = i + 1
  }

  j:int = length(a) - 5
  while j < length(a) {
    print(" ")
    printi(a[j])
    j = j + 1
  }

  println("")
}

main(args:int[][]) {
  n:int = 50000000
  a:int[n]
  i:int = 0
  while i < n {
    a[i] = n - 1 - i
    i = i + 1
  }

  quicksort(a, 0, n - 1)

  if n <= 10 {
    printAll(a)
  }
  else {
    printEnds(a)
  }
}