// Scalar induction values stay hot around repeated array addressing.
use io

main(args:int[][]) {
  n:int = 32000000
  data:int[4096]
  i:int,idx:int,p:int,q:int,r:int,s:int = 0,0,1,3,5,7
  t:int,u:int,v:int,total:int = 11,13,17,0
  while i < n {
    p = p + q; q = q + r; r = r + s
    s = s + t; t = t + u; u = u + v
    v = v + p + i
    data[idx] = p + r + t + v
    total = total + data[idx] + q + s + u
    idx = idx + 1; i = i + 1
    if idx == 4096 { idx = 0 }
  }
  printi(total + p + q + r + s + t + u + v)
  println("")
}
