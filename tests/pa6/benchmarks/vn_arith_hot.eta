// Repeated arithmetic expressions stay in one local value-numbering block.
use io

main(args:int[][]) {
  i:int = 0
  live:int = 1
  x:int,y:int,z:int = 3,5,7
  while i < 120000000 {
    a:int = x * y + z
    b:int = x * y + z
    c:int = (x + y) * (x + y)
    d:int = (y + x) * (x + y)
    live = live + a + b + c + d + i
    x = x + 1; y = y + 2; i = i + 1
  }
  printi(live)
  println("")
}
