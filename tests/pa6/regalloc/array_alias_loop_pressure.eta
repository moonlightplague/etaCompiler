// Expected output:
// arrays-ok
// 170
// 20
// 11
//
// Rectangular arrays, aliases, nested loops, string concatenation, and values
// live across loop backedges put sustained pressure on the allocator.
use io
use conv

build(rows:int, cols:int):int[][] {
    m:int[rows][cols]
    i:int = 0
    while i < rows {
        j:int = 0
        while j < cols {
            m[i][j] = (i + 1) * (j + 2) + i - j
            j = j + 1
        }
        i = i + 1
    }
    return m
}

fold(m:int[][]):int {
    i:int = 0
    total:int = 0
    while i < length(m) {
        row:int[] = m[i]
        j:int = 0
        row_total:int = 0
        while j < length(row) {
            keep0:int = total
            keep1:int = row_total
            keep2:int = i + j
            row_total = keep1 + row[j] + keep2 - i - j
            total = keep0
            j = j + 1
        }
        total = total + row_total
        i = i + 1
    }
    return total
}

main(args:int[][]) {
    table:int[][] = build(3, 4)
    alias:int[] = table[1]
    alias[2] = 99
    table[2][0] = table[0][3] + alias[1]

    msg:int[] = "arrays" + "-" + "ok"
    if length(msg) == 9 & table[1][2] == 99 {
        println(msg)
    } else {
        println("arrays-bad")
    }

    println(unparseInt(fold(table)))
    println(unparseInt(table[0][0] + table[1][1] + table[2][2]))
    println(unparseInt(length(msg) + table[2][0] - alias[1]))
}
