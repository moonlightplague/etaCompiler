// Expected output:
// 384
// 136
// 520
//
// Long move chains plus branch-dependent live ranges. This is meant to create
// many move-related temporaries so coalescing and freezing both matter.
use io
use conv

chain(x:int, y:int):int {
    a0:int = x
    a1:int = a0
    a2:int = a1
    a3:int = a2
    a4:int = a3
    a5:int = a4
    a6:int = a5
    a7:int = a6
    a8:int = a7

    b0:int = y
    b1:int = b0
    b2:int = b1
    b3:int = b2
    b4:int = b3
    b5:int = b4
    b6:int = b5
    b7:int = b6
    b8:int = b7

    keep1:int = a0 + a2 + a4 + a6 + a8
    keep2:int = b0 + b2 + b4 + b6 + b8
    c:int = a8 + b8
    d:int = c
    e:int = d
    f:int = e

    i:int = 0
    while i < 5 {
        t0:int = f
        t1:int = t0
        t2:int = t1
        f = t2 + i + a3 - b3
        if (f > keep1 & !(f == keep2)) {
            f = f + 1
        } else {
            f = f - 1
        }
        i = i + 1
    }

    return f + keep1 - keep2
}

main(args:int[][]) {
    r1:int = chain(40, 7)
    r2:int = chain(15, 4)
    println(unparseInt(r1))
    println(unparseInt(r2))
    println(unparseInt(r1 + r2))
}
