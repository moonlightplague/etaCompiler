use io
use conv

// Builds the Longest Prefix Suffix (LPS) array
build_lps(pattern: int[]): int[] {
    m: int = length(pattern)
    lps: int[m]

    if m == 0 {
        return lps
    }

    lps[0] = 0
    len_lps: int = 0
    i: int = 1

    while i < m {
        if pattern[i] == pattern[len_lps] {
            len_lps = len_lps + 1
            lps[i] = len_lps
            i = i + 1
        } else {
            if len_lps != 0 {
                // Fall back in the prefix table
                len_lps = lps[len_lps - 1]
            } else {
                lps[i] = 0
                i = i + 1
            }
        }
    }

    return lps
}

// Searches for pattern in text using KMP.
// Returns the starting index of the first match, or -1 if not found.
kmp_search(text: int[], pattern: int[]): int {
    n: int = length(text)
    m: int = length(pattern)

    if m == 0 {
        return 0
    }
    if n < m {
        return -1
    }

    lps: int[] = build_lps(pattern)
    i: int = 0 // index for text
    j: int = 0 // index for pattern
    result: int = -1

    // The loop uses short-circuiting to break early once a result is found
    while i < n & result == -1 {
        if pattern[j] == text[i] {
            j = j + 1
            i = i + 1
        }

        if j == m {
            // Match found!
            result = i - j
        } else {
            // Mismatch after j matches
            if i < n {
                if pattern[j] != text[i] {
                    if j != 0 {
                        j = lps[j - 1]
                    } else {
                        i = i + 1
                    }
                }
            }
        }
    }

    return result
}

main(args: int[][]) {
    // String literals are treated as int[] arrays in Eta
    text: int[] = "aaaaaaaaaaaabbbbababcabcabababd"
    pattern: int[] = "ababd"

    print("Searching for pattern: ")
    println(pattern)
    print("In text: ")
    println(text)

    index: int = kmp_search(text, pattern)

    if index != -1 {
        print("Pattern successfully found at index: ")
        print(unparseInt(index))
        println("")
    } else {
        println("Pattern not found in the text.")
    }
}