g:int = 'A'
flag:bool = true
buf:int[] 

setFlag(b:bool) {
  flag = b
}

even(n:int):bool {
  if n == 0 { return true }
  else { return odd(n-1) }
}

odd(n:int):bool {
  if n == 0 { return false }
  else { return even(n-1) }
}

main(args:int[][]) {
  setFlag(false)
  buf = "Hi" + {10,}
  e:bool = even(10)
}