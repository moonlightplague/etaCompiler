use io
use conv

steps:int = 0
banner:int[]

gcd(a:int, b:int):int {
    while a != 0 {
        if a < b {
            b = b - a
        } else {
            a = a - b
        }
    }
    return b
}

reduce(num:int, den:int):int, int {
    g:int = gcd(num, den)
    return num / g, den / g
}

sort(a:int[]) {
    i:int = 0
    while i < length(a) {
        j:int = i
        while j > 0 {
            if a[j - 1] > a[j] {
                a[j - 1], a[j] = a[j], a[j - 1]
                steps = steps + 1
            }
            j = j - 1
        }
        i = i + 1
    }
}

build(n:int):int[][] {
    m:int[n][n]
    i:int = 0
    while i < n {
        j:int = 0
        while j < n {
            if i == j | (i + j) == (n - 1) {
                m[i][j] = 1
            } else {
                m[i][j] = (i + 1) * (j + 1)
            }
            j = j + 1
        }
        i = i + 1
    }
    return m
}

rowSum(r:int[]):int {
    i:int = 0
    s:int = 0
    while i < length(r) {
        s = s + r[i]
        i = i + 1
    }
    return s
}

main(args:int[][]) {
    banner = "stress"

    data:int[] = {9, 8, 7, 6, 5, 4, 3, 2, 1, 0, 11, 10, 13, 12, 15, 14}
    sort(data)

    p:int, q:int = reduce(84, 126)

    table:int[][] = build(5)
    table[0][0], table[4][4] = table[4][4], table[0][0]

    copy:int[] = banner + ":"
    copy = copy + "ok"

    print(copy)
    print("\n")
    print(unparseInt(data[0]))
    print("\n")
    print(unparseInt(data[length(data) - 1]))
    print("\n")
    print(unparseInt(p))
    print("/")
    print(unparseInt(q))
    print("\n")
    print(unparseInt(rowSum(table[0])))
    print("\n")
    print(unparseInt(rowSum(table[2])))
    print("\n")
    print(unparseInt(steps))
    print("\n")
}