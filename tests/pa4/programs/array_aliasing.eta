use io
use conv

// Global variables to track state
debug_mode: bool = true
operations_count: int = 0

// Initializes an identity matrix of size n x n
create_identity(n: int): int[][] {
    matrix: int[n][n]
    i: int = 0

    while i < length(matrix) {
        j: int = 0
        while j < length(matrix[i]) {
            if i == j {
                matrix[i][j] = 1
            } else {
                matrix[i][j] = 0
            }
            operations_count = operations_count + 1
            j = j + 1
        }
        i = i + 1
    }
    return matrix
}

main(args: int[][]) {
    size: int = 5
    m1: int[][] = create_identity(size)

    // Test array aliasing
    m2: int[][] = m1
    m2[0][0] = 99 // Should also mutate m1[0][0] since they share pointers

    if debug_mode {
        print("Operations performed: ")
        print(unparseInt(operations_count))
        println("")

        print("m1[0][0] after aliased mutation: ")
        print(unparseInt(m1[0][0]))
        println("")
    }
}